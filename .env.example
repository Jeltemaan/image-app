# n8n webhook that accepts image1 + image2 as multipart/form-data and returns a binary image.
# Copy this file to .env.local and fill in your own URL (.env.local is gitignored).
#
#   /webhook/<id>       production - requires the workflow switched Active
#   /webhook-test/<id>  editor only - requires "Listen for test event", one request per arming
N8N_WEBHOOK_URL=https://YOUR-INSTANCE.app.n8n.cloud/webhook/YOUR-WEBHOOK-ID
