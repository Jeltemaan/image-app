# n8n webhook that accepts image1 + image2 as multipart/form-data and returns a binary image.
# Copy this file to .env.local and fill in your own URL (.env.local is gitignored).
#
#   /webhook/<id>       production - requires the workflow switched Active
#   /webhook-test/<id>  editor only - requires "Listen for test event", one request per arming
N8N_WEBHOOK_URL=https://YOUR-INSTANCE.app.n8n.cloud/webhook/YOUR-WEBHOOK-ID

# Supabase project used for email + password auth. Both values are public by
# design (row level security is the real boundary), hence NEXT_PUBLIC_. Copy
# them from Project Settings > API. Never add the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Stripe. The app is a $9.99/month subscription bought through a Payment Link.
# The secret key can charge cards and read every customer on the account, so it
# is server-only - never give it a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
# Printed by `stripe listen --forward-to localhost:3001/api/stripe/webhook`
# locally; in production it comes from the webhook endpoint in the dashboard.
# A fresh secret is issued each time `stripe listen` starts.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
# The hosted Payment Link. The app appends client_reference_id (the Supabase
# user id) so the payment can be matched back to an account.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_YOUR_LINK

# Supabase service-role key. Bypasses row level security, so this is the one
# genuinely privileged value in the project: it exists only because the Stripe
# webhook arrives with no user session and still has to write the entitlement.
# Imported by lib/supabase/admin.ts and nowhere else. Never commit a real one.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
